# FormFlow Environment Configuration
# Copy this to .env and fill in your values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=FormFlow
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG

# =============================================================================
# Inference Provider Settings
# =============================================================================
# Options: "ollama" (development) or "vllm" (production)
INFERENCE_PROVIDER=ollama

# Ollama (development)
INFERENCE_BASE_URL=http://localhost:11434
INFERENCE_MODEL=ministral-3:8b

# vLLM (production) - uncomment when using vLLM
# INFERENCE_BASE_URL=http://localhost:8000/v1
# INFERENCE_MODEL=Qwen/Qwen2-VL-7B-Instruct

# Timeout for inference requests (seconds)
INFERENCE_TIMEOUT=120

# =============================================================================
# Paths (for local development without Docker)
# =============================================================================
CONFIGS_DIR=./configs
TEMPLATES_DIR=./templates
FEEDBACK_DIR=./feedback

# =============================================================================
# CORS Settings
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Production Settings (uncomment when deploying)
# =============================================================================
# HUGGING_FACE_HUB_TOKEN=your_token_here
